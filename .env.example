# ChronoBunker Core - Environment Configuration
# Copy this file to .env and fill in your own API keys.

CHRONO_DB_URL=postgres://chrono_app:change_me_in_production@localhost:5432/chronobunker?sslmode=disable
CHRONO_REDIS_ADDR=localhost:6379
CHRONO_JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem
CHRONO_JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
CHRONO_ROUTING_POLICY_PATH=policies/routing.yaml
CHRONO_CANARY_TOKEN=CANARY-DEV-ONLY
CHRONO_ENV=development

# Get your own free keys:
#   Groq:    https://console.groq.com
#   Gemini:  https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=