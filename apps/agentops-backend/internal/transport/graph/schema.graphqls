scalar Time
scalar JSON

enum AgentStatus {
  DRAFT
  CANARY
  PRODUCTION
  KILLED
}

type Agent {
  id: ID!
  tenantId: ID!
  name: String!
  department: String!
  status: AgentStatus!
  healthScore: Float!
  allowedTools: [String!]!
  targetModel: String!
  breakerState: String!
  createdAt: Time!
  updatedAt: Time!
}

input CreateAgentInput {
  name: String!
  department: String!
  targetModel: String
}

input UpdateAgentStatusInput {
  id: ID!
  status: AgentStatus!
}

input InvokeAgentInput {
  agentId: ID!
  prompt: String!
  sessionId: String!
}

type InvokeAgentResult {
  completion: String!
  modelId: String!
  costUsd: Float!
  latencyMs: Int!
}

input InvokeToolInput {
  agentId: ID!
  sessionId: String!
  deviceId: String!
  toolName: String!
  params: JSON!
}

type InvokeToolResult {
  result: JSON!
  cached: Boolean!
  executed: Boolean!
}

type CostSummary {
  tenantId: ID!
  totalUsd: Float!
  eventCount: Int!
  from: Time!
  to: Time!
}

type Query {
  agents: [Agent!]!
  agent(id: ID!): Agent
  costs(from: Time!, to: Time!): CostSummary!
}

type Mutation {
  createAgent(input: CreateAgentInput!): Agent!
  updateAgentStatus(input: UpdateAgentStatusInput!): Agent!
  invokeAgent(input: InvokeAgentInput!): InvokeAgentResult!
  invokeTool(input: InvokeToolInput!): InvokeToolResult!
}

type LoginResult {
  token: String!
  tenantId: ID!
  deviceId: String!
}

extend type Mutation {
  login(tenantId: ID!): LoginResult!
}

type AuditEntry {
  id: ID!
  tenantId: ID!
  sessionId: String!
  toolName: String
  decision: String!
  prevHash: String!
  rowHash: String!
  createdAt: Time!
}

extend type Subscription {
  auditEntryAdded: AuditEntry!
}

extend type Query {
  auditEntries(limit: Int!): [AuditEntry!]!
}

type RedTeamResult {
  id: ID!
  name: String!
  owaspCategory: String!
  status: String!
  detail: String!
  durationMs: Int!
  ranAt: Time!
}

extend type Subscription {
  redTeamStream: RedTeamResult!
}

extend type Mutation {
  runRedTeam: Boolean!
}

type Order {
  id: ID!
  tenantId: ID!
  customerName: String!
  product: String!
  quantity: Int!
  totalUsd: Float!
  status: String!
  createdAt: Time!
  updatedAt: Time!
}

extend type Query {
  orders: [Order!]!
  order(id: ID!): Order
}