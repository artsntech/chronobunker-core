scalar Time

enum AgentStatus {
  DRAFT
  CANARY
  PRODUCTION
  KILLED
}

type Agent {
  id: ID!
  tenantId: ID!
  name: String!
  department: String!
  status: AgentStatus!
  healthScore: Float!
  allowedTools: [String!]!
  targetModel: String!
  createdAt: Time!
  updatedAt: Time!
}

input CreateAgentInput {
  name: String!
  department: String!
  targetModel: String
}

input UpdateAgentStatusInput {
  id: ID!
  status: AgentStatus!
}

type Query {
  agents: [Agent!]!
  agent(id: ID!): Agent
}

type Mutation {
  createAgent(input: CreateAgentInput!): Agent!
  updateAgentStatus(input: UpdateAgentStatusInput!): Agent!
}

input InvokeAgentInput {
  agentId: ID!
  prompt: String!
  sessionId: String!
}

type InvokeAgentResult {
  completion: String!
  modelId: String!
  costUsd: Float!
  latencyMs: Int!
}

type CostSummary {
  tenantId: ID!
  totalUsd: Float!
  eventCount: Int!
  from: Time!
  to: Time!
}

extend type Mutation {
  invokeAgent(input: InvokeAgentInput!): InvokeAgentResult!
}

extend type Query {
  costs(from: Time!, to: Time!): CostSummary!
}